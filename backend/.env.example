# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── API Security ──────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here-change-this

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
# Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Local:    postgresql://postgres:postgres@localhost:5432/anteclick
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anteclick

# ─── Redis Configuration ───────────────────────────────────────────────────────
# Upstash:  rediss://default:<password>@<host>.upstash.io:6379
# Local:    redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=600

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ─── Scheduler Intervals (minutes) ────────────────────────────────────────────
OPENPHISH_INTERVAL_MINS=60
URLHAUS_INTERVAL_MINS=60
PHISHTANK_INTERVAL_MINS=720
TRANCO_INTERVAL_MINS=1440

# ─── External APIs (optional — for enhanced reputation lookup) ─────────────────
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# ─── CORS (comma-separated allowed origins) ────────────────────────────────────
ALLOWED_ORIGINS=https://anteclick.com,https://api.anteclick.com

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8000
WORKERS=2
