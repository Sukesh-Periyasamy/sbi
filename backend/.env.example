# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# API Security
API_KEY=your-secure-api-key-here-change-this

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# External APIs (optional - for enhanced reputation lookup)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://trustshield.app,https://api.trustshield.app

# Server
PORT=8000
WORKERS=2
