<?xml version="1.0" encoding="utf-8"?>
<!--
    AccessibilityService configuration for AnteClick Financial Phishing Protection.

    SCOPE:
    AnteClick monitors ONLY browser address bars and in-app browser URLs to detect
    suspicious financial phishing websites. It does NOT read messages, passwords,
    OTPs, personal data, or general app content.

    EVENT TYPES:
    - TYPE_WINDOW_STATE_CHANGED: Detects when a new browser tab or in-app browser opens
    - TYPE_WINDOW_CONTENT_CHANGED: Detects when the browser address bar updates

    PACKAGE FILTERING:
    Package filtering is performed in code (not XML) to support in-app browsers
    (Telegram, WhatsApp, Instagram) where events carry the host app's package name.
    Only browser and messaging app packages are monitored.

    PRIVACY:
    - No browsing history stored
    - No personal data collected
    - Only suspicious URLs sent to backend for verification
    - Safe websites never leave the device
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:packageNames="com.android.chrome,org.mozilla.firefox,com.sec.android.app.sbrowser,com.microsoft.emmx,com.brave.browser,com.opera.browser,com.opera.mini.native,com.miui.hybrid,com.mi.globalbrowser,org.telegram.messenger,org.telegram.messenger.web,com.whatsapp,com.instagram.android,com.facebook.katana,com.google.android.gm,com.twitter.android,com.discord,com.snapchat.android"
    android:description="@string/accessibility_service_description" />
